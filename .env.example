# .env.example
# Flask Configuration
JWT_SECRET=your_jwt_secret_key_here_change_in_production
DATABASE_PROVIDER=sqlite
DB_PATH=./db/app.db

# Local SQLite safety backups. Keep this outside the repository because backups can
# contain real diary data, attachments metadata, and test entries.
SQLITE_BACKUP_DIR=~/AIDiaryBackups
SQLITE_BACKUP_RETAIN=14
POSTGRES_SNAPSHOT_DIR=~/AIDiaryBackups/postgres-snapshots

# Managed Postgres rehearsal/production
# Use standard Postgres DATABASE_URL for Neon, Supabase, Render, Railway,
# DigitalOcean, Azure, or another compatible host. Do not add provider SDKs
# for the initial database migration.
# DATABASE_PROVIDER=postgres
# DATABASE_USES_POOLER=true
DATABASE_URL=
CORS_ORIGINS=http://localhost:4200
FLASK_ENV=development

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Server Configuration
FLASK_PORT=5001

# OAuth / OIDC
FRONTEND_BASE_URL=http://localhost:4200
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URI=http://localhost:5001/api/oauth/google/callback
# Optional: requests Google People API birthday/gender/locale scopes.
# Requires Google People API enabled for the OAuth project.
OAUTH_GOOGLE_EXTENDED_PROFILE=false

# Stripe Billing / Checkout
# Leave blank for local free-tier-only development. Production paid checkout requires
# secret, webhook, and monthly/annual Price IDs for every paid tier.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PERSONAL_MONTHLY=
STRIPE_PRICE_PERSONAL_ANNUAL=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_ANNUAL=
# Optional hosted Stripe return URLs. Defaults are derived from FRONTEND_BASE_URL.
STRIPE_CHECKOUT_SUCCESS_URL=
STRIPE_CHECKOUT_CANCEL_URL=
STRIPE_CUSTOMER_PORTAL_RETURN_URL=

# Public production hardening.
# APP_ENV=production blocks unsafe local defaults unless an explicit emergency fallback
# flag is set for an operator-controlled rollback window.
APP_ENV=development
RATELIMIT_STORAGE_URI=memory://
OPENMYND_ALLOW_SQLITE_PRODUCTION_FALLBACK=false
OPENMYND_ALLOW_RUNTIME_MIGRATIONS_IN_PRODUCTION=false
OPENMYND_REQUIRE_REGISTRATION_EMAIL=false
OPENMYND_DISABLE_LEGACY_PASSWORD_FALLBACK=false
# Cookie-session migration foundation. Keep disabled until CSRF and frontend smoke
# coverage are complete for the target deployment.
OPENMYND_AUTH_COOKIE_MODE=false
OPENMYND_AUTH_COOKIE_CSRF_PROTECT=false
JWT_COOKIE_SAMESITE=Lax
# Temporary beta acceptance flags. Keep false unless the launch owner explicitly
# accepts the documented risk while the safer long-term replacement is still pending.
OPENMYND_ACCEPT_LOCALSTORAGE_JWT_RISK=false
OPENMYND_ACCEPT_LEGACY_PASSWORD_FALLBACK=false

# NLTK enrichment startup controls.
# Keep both disabled by default so local/cloud startup never blocks on network downloads
# or long legacy metadata backfills. Enable manually only when preparing NLTK data.
OPENMYND_AUTO_DOWNLOAD_NLTK=false
OPENMYND_STARTUP_NLTK_BACKFILL=false
