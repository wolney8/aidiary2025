# Environment Configuration Example
# Copy this file to .env and configure your values

# Database Configuration
# Local SQLite
DATABASE_PROVIDER=sqlite
DB_PATH=db/app.db

# Managed Postgres rehearsal/production
# Keep provider-specific values out of code. Neon, Supabase, Render, Railway,
# DigitalOcean, Azure, and other standard Postgres hosts should work through this URL.
# DATABASE_PROVIDER=postgres
# DATABASE_USES_POOLER=true
DATABASE_URL=

# AI Services
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=1000

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here

# CORS Configuration
CORS_ORIGINS=http://localhost:4200

# Media storage
# Use local for development. Use r2 for hosted deployments without durable disk.
MEDIA_STORAGE_BACKEND=local
MEDIA_ROOT=
MEDIA_BASE_URL=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# OAuth / OIDC
FRONTEND_BASE_URL=http://localhost:4200
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URI=http://localhost:5001/api/oauth/google/callback
# Optional: requests Google People API birthday/gender/locale scopes.
# Requires Google People API enabled for the OAuth project.
OAUTH_GOOGLE_EXTENDED_PROFILE=false

# Stripe Billing / Checkout
# Leave blank for local free-tier-only development. Production paid checkout requires
# secret, webhook, and monthly/annual Price IDs for every paid tier.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PERSONAL_MONTHLY=
STRIPE_PRICE_PERSONAL_ANNUAL=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_ANNUAL=
# Optional hosted Stripe return URLs. Defaults are derived from FRONTEND_BASE_URL.
STRIPE_CHECKOUT_SUCCESS_URL=
STRIPE_CHECKOUT_CANCEL_URL=
STRIPE_CUSTOMER_PORTAL_RETURN_URL=

# Transactional email
# Local development can leave EMAIL_PROVIDER=console.
# Public production requires SMTP plus OPENMYND_REQUIRE_REGISTRATION_EMAIL=true.
EMAIL_PROVIDER=console
OPENMYND_DEFER_EMAIL_DELIVERY=false
EMAIL_FROM_ADDRESS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
OPENMYND_REQUIRE_REGISTRATION_EMAIL=false

# Import Settings
MAX_IMPORT_FILE_SIZE=10485760  # 10MB in bytes
ALLOWED_IMPORT_EXTENSIONS=xlsx,xls,csv
IMPORT_TEMP_DIR=temp/imports

# Application Settings
FLASK_ENV=development
FLASK_DEBUG=True
APP_ENV=development
RATELIMIT_STORAGE_URI=memory://
OPENMYND_DEFER_SHARED_RATE_LIMITING=false

# Backup/restore evidence paths for Admin -> Operations -> Database maintenance.
OPENMYND_BACKUP_SUMMARY_DIR=
OPENMYND_SQLITE_BACKUP_DIR=
OPENMYND_POSTGRES_SNAPSHOT_DIR=
OPENMYND_MEDIA_BACKUP_DIR=
OPENMYND_RESTORE_REPORT=

# Public production hardening.
# APP_ENV=production blocks unsafe local defaults unless an explicit emergency fallback
# flag is set for an operator-controlled rollback window.
OPENMYND_ALLOW_SQLITE_PRODUCTION_FALLBACK=false
OPENMYND_ALLOW_RUNTIME_MIGRATIONS_IN_PRODUCTION=false
# Optional one-time admin recovery for hosted environments. Comma-separated
# usernames or emails. Remove after the expected admin entitlement appears.
OPENMYND_BOOTSTRAP_ADMIN_USERS=
# Accepted aliases for hosted environments where naming differs:
# OPENMYND_ADMIN_USERS=
# OPENMYND_ADMIN_EMAILS=
# BOOTSTRAP_ADMIN_USERS=
# ADMIN_USERS=

# NLTK enrichment startup controls.
# Keep both disabled by default so local/cloud startup never blocks on network downloads
# or long legacy metadata backfills. Enable manually only when preparing NLTK data.
OPENMYND_AUTO_DOWNLOAD_NLTK=false
OPENMYND_STARTUP_NLTK_BACKFILL=false
