{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist/openmynd"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/media/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/health",
      "dest": "/api/index.py"
    },
    {
      "src": "/(.*\\.(?:js|css|ico|png|jpg|jpeg|webp|svg|gif|woff|woff2|ttf|eot|map|json|txt))",
      "dest": "/client/dist/openmynd/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/client/dist/openmynd/index.html"
    }
  ]
}
