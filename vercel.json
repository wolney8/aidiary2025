{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd client && npm install",
  "buildCommand": "cd client && npm run build:vercel",
  "outputDirectory": "client/dist/openmynd",
  "functions": {
    "api/index.py": {
      "runtime": "python3.12",
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/media/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/health",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!api|media|assets|favicon.ico).*)",
      "destination": "/index.html"
    }
  ]
}
