{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/app"
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/**/*.spec.ts",
    "src/test.ts",
    "src/testing-globals.d.ts",
    "src/environments/environment.cookie-only.ts",
    "src/environments/environment.hosted.ts",
    "src/app/core/services/autosave.service.ts",
    "tests/**/*",
    "playwright.config.ts"
  ]
}
